# Copy to fetch/.env and fill in. fetch/.env is git-ignored and must never be committed.

# "sandbox" while testing, "production" once live keys are approved
ETRADE_ENV=sandbox

ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# Optional: last four digits of the account holding the portfolio.
# Leave blank to be prompted when more than one account exists.
ETRADE_ACCOUNT_ID=

# Shared password members type to view the site. Use a long passphrase
# (four or more random words). Changing it: edit here, then run
#   python fetch/fetch_portfolio.py --reencrypt --publish
SITE_PASSWORD=

# Name shown on the site after login
PORTFOLIO_NAME=Managed Portfolio
